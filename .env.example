# ==============================================================================
# FarmSaathi AI — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
#
# For Vercel deployments, configure these in:
#   Vercel Dashboard > Project Settings > Environment Variables
#
# For Netlify deployments, configure these in:
#   Site Configuration > Environment Variables
# ==============================================================================

# Server Port (Local Development)
PORT=3000

# ------------------------------------------------------------------------------
# 1. OpenAI Configuration (Server-Side Only - NEVER expose to browser)
# ------------------------------------------------------------------------------
# Required for live multimodal AI chat and crop image vision analysis.
# If omitted or empty, FarmSaathi AI runs on its built-in trilingual agronomic engine.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Indian Government Mandi API (Optional - Server-Side Only)
# ------------------------------------------------------------------------------
# Optional: Data.gov.in / Agmarknet API Key for live Mandi daily feeds.
# If omitted, FarmSaathi AI serves verified APMC mandi records across all states.
DATA_GOV_IN_API_KEY=your_datagov_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Configuration (Public Variables)
# ------------------------------------------------------------------------------
# These are public client-side variables and use Row Level Security (RLS).
# NEVER place service_role keys here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
