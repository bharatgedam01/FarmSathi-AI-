# ==============================================================================
# FarmSaathi AI — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# For Netlify deployments, configure these in:
#   Site Configuration > Environment Variables
# ==============================================================================

# Port for local server (default: 3000)
PORT=3000

# OpenAI API Key (Required for real AI Chat and Crop Photo Vision Analysis)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Models to use (gpt-4o-mini is recommended for fast, cost-effective multimodal triage)
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: Data.gov.in / Agmarknet API Key for live Indian Mandi Feeds
# If omitted, FarmSaathi AI uses verified APMC mandi market records
DATA_GOV_IN_API_KEY=

# Supabase Client Configuration (Public variables; safe in browser/index.html)
# Configure these in index.html CONFIG object or via environment if bundling
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
