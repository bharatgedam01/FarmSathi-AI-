# ==============================================================================
# FarmSaathi AI — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
#
# For Vercel deployments, configure these in:
#   Vercel Dashboard > Project Settings > Environment Variables
#
# For Netlify deployments, configure these in:
#   Site Configuration > Environment Variables
# ==============================================================================

# Server Port (Local Development)
PORT=3000

# ------------------------------------------------------------------------------
# 1. AI & Multimodal Vision Configuration (Server-Side Only - NEVER expose to browser)
# ------------------------------------------------------------------------------
# Provide either Google Gemini (recommended for cost-free tier) OR OpenAI:
#
# Option A: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Indian Government Mandi API (Optional - Server-Side Only)
# ------------------------------------------------------------------------------
# Optional: Data.gov.in / Agmarknet API Key for live Mandi daily feeds.
# If omitted, FarmSaathi AI serves verified APMC mandi records across all states.
DATA_GOV_IN_API_KEY=your_datagov_api_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Configuration (Public Variables)
# ------------------------------------------------------------------------------
# These are public client-side variables and use Row Level Security (RLS).
# NEVER place service_role keys here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here

# ------------------------------------------------------------------------------
# 4. Automated Government Schemes Cron Security (Server-Side Only)
# ------------------------------------------------------------------------------
# Used by Vercel Cron Jobs (0 4 * * *) to securely trigger /api/cron/schemes.
CRON_SECRET=farmsaathi-cron-secret-2026

